# Resend API key for sending emails (password reset, invites)
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Optional: customize the "from" address (requires verified domain in Resend)
# Defaults to "Pointy <onboarding@resend.dev>" (Resend sandbox)
# FROM_EMAIL="Pointy <noreply@yourdomain.com>"

# Optional: set a custom password for the seed admin user
# Defaults to "password" if not set -- CHANGE THIS IN PRODUCTION
# ADMIN_SEED_PASSWORD=your_secure_password_here
